# PostgreSQL（本地 docker compose 的默认值）
DATABASE_URL=postgres://experiencenet:experiencenet_dev_only@127.0.0.1:5433/experiencenet
BIND_ADDR=127.0.0.1:8080
APP_ORIGIN=http://localhost:5173
STATIC_DIR=../web/dist

# 可选：Embedding 服务（OpenAI 兼容接口，不填则仅用词法检索）
# 推荐：智谱 Embedding-3（中文好、国内快，0.5元/百万token）
# EMBEDDING_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/embeddings
# EMBEDDING_API_KEY=你的智谱APIKey
# EMBEDDING_MODEL=embedding-3
#
# 也可用 OpenAI / 本地 Ollama 等任何 OpenAI 兼容服务
# EMBEDDING_ENDPOINT=http://localhost:11434/v1/embeddings
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=bge-m3

# 可选：反向代理场景（生产）。逗号分隔的可信代理网段，设置后限流按 X-Forwarded-For 解析真实客户端 IP。
# TRUSTED_PROXIES=172.16.0.0/12

# 可选：检索相关度阈值（0-1）。低于阈值的候选不返回，避免塞满 Agent 上下文。
# SEARCH_LEXICAL_MIN_SCORE=0.10
# SEARCH_SEMANTIC_MIN_SCORE=0.50
